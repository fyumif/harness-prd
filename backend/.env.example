# ---- 火山方舟（兼容 OpenAI 接口）----
# 复制本文件为 .env 后填入真实 API Key
ARK_API_KEY=
# 如使用其他区域，可修改接入地址（默认值见 core/config.py）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型调用使用的 Coding 专用入口（一般无需修改）
# ARK_CODING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# ---- LLM 默认配置 ----
# 当前仅支持 openai 兼容协议（火山方舟）
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=doubao-seed-2.1-turbo

# ---- 跨域 ----
# 多个来源用英文逗号分隔，例如：http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# ---- 服务监听 ----
HOST=0.0.0.0
PORT=8000
